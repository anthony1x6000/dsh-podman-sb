{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "lib",
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts"],
  "exclude": ["lib", "selfcheck.ts", "node_modules"]
}
